# =============================================================================
# Sistema de Diagnóstico Organizacional LinkTIC
#
# Copie este archivo como `.env.local` y complete los valores marcados [REQUERIDA].
# O, con el proyecto enlazado a Vercel (`npx vercel link`), traiga las variables del
# proyecto con:   npx vercel env pull .env.local
#
# Las pantallas y la API (src/app/api/v1) son un solo proyecto de Next. Ninguna
# variable de aquí lleva el prefijo NEXT_PUBLIC_ salvo las dos del final: todo lo
# NEXT_PUBLIC_ queda incrustado en el bundle del navegador y es visible para
# cualquiera, así que ahí nunca va un secreto.
#
# Referencia completa, con los valores de producción y el diagnóstico de fallos:
# docs/VARIABLES-DE-ENTORNO.md
#
# Índice
#   1. Base de datos (Supabase)
#   2. Acceso al panel de administración
#   3. Privacidad y seguridad
#   4. Declaradas pero aún no consumidas
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Base de datos (Supabase)
#
# EN VERCEL NO HAY QUE DECLARAR NADA DE ESTA SECCIÓN si la base está conectada
# al proyecto (Storage → Supabase, o la integración del Marketplace): la
# integración inyecta POSTGRES_PRISMA_URL y POSTGRES_URL_NON_POOLING, y el código
# las usa cuando faltan las dos de abajo. Declararlas sobreescribe a la integración.
#
# En local, o sin la integración, hacen falta DOS cadenas y confundirlas cuesta
# caro. Ambas se copian del panel de Supabase:
# Project Settings → Database → Connection string → Connection pooling.
#
#   DATABASE_URL  puerto 6543 + ?pgbouncer=true   runtime de la app
#   DIRECT_URL    puerto 5432                     solo el CLI de Prisma
#
# LA REGIÓN DEL HOST DEBE SER LA DE SU PROYECTO. Si no coincide, el pooler responde
# "tenant/user postgres.<ref> not found", que suena a credenciales pero es la región.
#
# Si la contraseña tiene caracteres especiales (! # $ % & etc.), va URL-encoded:
# `!` → %21, `#` → %23, `$` → %24, `%` → %25, `&` → %26.
#
# La conexión viaja cifrada aunque la cadena no diga `sslmode`: `src/server/db.ts`
# exige TLS contra cualquier host que no sea local.
# -----------------------------------------------------------------------------

# [REQUERIDA sin la integración de Vercel]
# Runtime de la app. POOLER en modo TRANSACCIÓN: puerto 6543 y ?pgbouncer=true.
# Es el que soporta las muchas conexiones efímeras de las funciones serverless.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# [REQUERIDA para migrate/seed — no la usa el runtime]
# Solo para el CLI de Prisma (`migrate`, `db seed`), vía `prisma.config.ts`.
# POOLER en modo SESIÓN: puerto 5432, SIN pgbouncer. Apuntada al 6543,
# `prisma migrate deploy` se queda colgada indefinidamente y sin error.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# 2. Acceso al panel de administración
# -----------------------------------------------------------------------------

# [REQUERIDA]
# Token que se canjea por la cookie de sesión en POST /api/v1/auth/login.
# ADVERTENCIA: `Admin123!@` es el valor inicial que pidió LinkTIC. Es predecible,
# y un token compartido no da trazabilidad por persona ni permite revocar el acceso
# de alguien sin afectar a los demás. Reemplácelo por una cadena aleatoria larga
# antes de exponer datos reales. El servidor emite un aviso al arrancar mientras
# siga siendo el valor por defecto (`src/instrumentation.ts`).
ADMIN_ACCESS_TOKEN=Admin123!@

# [REQUERIDA]
# Clave de firma del JWT de sesión. Cadena aleatoria de 64+ caracteres,
# DISTINTA de HASH_SALT. Generar con:  openssl rand -base64 48
# La usan los route handlers y también `src/proxy.ts`, que valida la firma antes
# de dejar pasar a /admin.
JWT_SECRET=

# [OPCIONAL — default: 8h]
# Vigencia de la sesión del panel. Formato 15m, 8h, 7d.
JWT_EXPIRES_IN=8h

# [OPCIONAL — default: linktic_admin_session]
# Nombre de la cookie de sesión. Antes había que repetirlo en el front como
# NEXT_PUBLIC_COOKIE_NAME; ahora lo leen el proxy y la API de esta sola variable.
COOKIE_NAME=linktic_admin_session


# -----------------------------------------------------------------------------
# 3. Privacidad y seguridad
# -----------------------------------------------------------------------------

# [REQUERIDA]
# Sal para hashear IPs y user agents; nunca se persisten en claro.
# Cadena aleatoria, DISTINTA de JWT_SECRET.  openssl rand -base64 48
# Cambiarla invalida el rate limit de login en curso (los hashes dejan de coincidir).
HASH_SALT=

# [OPCIONAL — default: 4]
# Mínimo de respuestas para publicar un corte. Por debajo de este número el panel
# muestra "datos insuficientes" en vez del dato: con dos o tres personas en un área,
# un promedio permite deducir quién dijo qué. No es desactivable desde la interfaz.
# Bajarla a 1 anula la garantía de anonimato.
MIN_COHORT_SIZE=4

# [OPCIONAL — default: 5]
# Intentos de login fallidos permitidos por IP dentro de la ventana. El contador se
# respalda en `admin_audit_log`, no en memoria, para que sobreviva a los arranques
# en frío de serverless.
LOGIN_RATE_LIMIT=5

# [OPCIONAL — default: 15]
# Ventana del rate limit de login, en minutos.
LOGIN_RATE_WINDOW_MINUTES=15


# -----------------------------------------------------------------------------
# 4. Declaradas pero aún no consumidas
#
# Ninguna de las dos se lee hoy en `src/`. Describen valores que la interfaz
# necesitará, pero cambiarlas no tiene efecto todavía:
#
#   NEXT_PUBLIC_APP_NAME       el título está fijo en `src/app/layout.tsx`
#   NEXT_PUBLIC_SUPPORT_EMAIL  no hay ningún enlace de soporte en la interfaz
#
# Si se cablean, hay que actualizar esta nota. Si se decide no usarlas, bórrelas
# de aquí y de `.env.local` para no arrastrar configuración muerta.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Diagnóstico Organizacional LinkTIC
NEXT_PUBLIC_SUPPORT_EMAIL=talentohumano@linktic.com
